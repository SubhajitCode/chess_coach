STOCKFISH_PATH=/opt/homebrew/bin/stockfish
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.3-8b-instruct:free

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio / Gemini (used when LLM_PROVIDER=google_ai_studio)
# GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
# GEMINI_API_KEY=your_google_ai_studio_api_key_here
# LLM_MODEL=gemini-3-flash-preview

# Optional provider-specific overrides
# OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free
# GOOGLE_AI_STUDIO_MODEL=gemini-3-flash-preview
# LLM_BASE_URL=
# OPENROUTER_BASE_URL=
# GOOGLE_AI_STUDIO_BASE_URL=
